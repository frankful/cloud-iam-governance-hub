# Local-development settings only. Do not use these credentials outside local development.
POSTGRES_DB=finops
POSTGRES_USER=finops
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379

# API settings. If using an existing local PostgreSQL instance, set DATABASE_URL
# to that instance's connection string.
DATABASE_URL=postgres://finops:change-me@127.0.0.1:5432/finops?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
API_ADDR=127.0.0.1:8080

# api-token is the required mode for docker compose: any caller presenting an
# X-User-ID header becomes platform_admin in development mode, and compose
# publishes the API on 0.0.0.0 — development is only safe for localhost runs
# outside containers. Anything else fails closed.
AUTH_MODE=api-token
# BLOCK is the safe default. WARN relaxes only admin-like role-name findings;
# wildcard/admin permissions and external trust remain blocking.
IAM_CANDIDATE_RISK_MODE=BLOCK

# docker compose (docker compose up -d --build) reads this file too.
# Compose overrides host-only settings internally:
#   DATABASE_URL / REDIS_ADDR point at the postgres / redis containers,
#   API_ADDR=0.0.0.0:8080 + API_ALLOW_NON_LOOPBACK=true are set for the api
#   container (port publishing requires a non-loopback bind).
# Local-only knob: host port the api container is published on.
API_PORT=8080

# First-start bootstrap (idempotent; never overwrites manual edits).
# BOOTSTRAP_AWS_ACCOUNT_ID unset = no account seeding.
BOOTSTRAP_AWS_ACCOUNT_ID=
BOOTSTRAP_AWS_ACCOUNT_NAME=
# Read-only role the collector assumes in that account (ASSUME_ROLE mode).
# Give it the AWS managed policy IAMReadOnlyAccess
# (arn:aws:iam::aws:policy/IAMReadOnlyAccess): the collector only calls
# iam:Get* / iam:List* and needs no write permission. In organization mode
# the ENTRY credential additionally needs organizations:ListAccounts to
# enumerate member accounts.
BOOTSTRAP_AWS_ROLE_ARN=
# CURRENT_CREDENTIALS (default, local single-account debugging) or ASSUME_ROLE
# (production: set BOOTSTRAP_AWS_ROLE_ARN as well).
BOOTSTRAP_AWS_SYNC_MODE=
BOOTSTRAP_AWS_SYNC_ENABLED=true
# api-token mode with zero active admins issues one admin token on first start.
BOOTSTRAP_ADMIN_USER_ID=admin
BOOTSTRAP_ADMIN_TOKEN_FILE=./data/bootstrap-admin-token.txt
BOOTSTRAP_ADMIN_TOKEN_TTL=720h

# Prometheus /metrics is loopback-only unless METRICS_TOKEN is set; then
# scrapers must send "Authorization: Bearer <METRICS_TOKEN>".
METRICS_TOKEN=

# Select github or gitlab. Never put a real token in this example file.
# The publisher token needs contents:write + pull_requests:write on the
# Terraform repository only — never an organization-wide token.
PUBLISHER=github
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository
GITHUB_API_URL=
GITHUB_TARGET_BRANCH=main
GITHUB_TERRAFORM_PATH=iam

GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_API_URL=
GITLAB_TARGET_BRANCH=main
GITLAB_TERRAFORM_PATH=iam

# AWS inventory collection.
#
# Which identity the platform uses to reach AWS, and the four ways to supply it
# (instance role, IRSA, shared profile, credential_process), is written up in
# docs/aws-credential-setup.md — read that before filling these in.
#
# Production: leave the three static-key variables unset. The platform uses the
# instance/task role (or AWS_PROFILE) only as the ENTRY credential, then assumes
# each managed account's read-only role. The platform never stores target-account
# credentials.
#
# The read-only role in every managed account carries the AWS managed policy
# IAMReadOnlyAccess (arn:aws:iam::aws:policy/IAMReadOnlyAccess) and trusts this
# entry identity (optionally with AWS_EXTERNAL_ID). The entry credential itself
# needs organizations:ListAccounts plus sts:AssumeRole, nothing more.
#
# On-prem deployments (no instance role available): the recommended entry is a
# dedicated IAM user whose ONLY permission is sts:AssumeRole pointed at the
# collector role(s) — never IAMReadOnlyAccess on the user itself. See
# docs/aws-credential-setup.md §4.A. On EC2/EKS leave all four unset.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# ^ When set, ONLY that shared-config profile is used. When unset, the SDK
#   default chain applies: env vars -> default profile -> container/instance
#   role -> SSO cache. On EC2/EKS leave it empty and use the attached role.
#   Shared-config profiles live in the HOST's ~/.aws (config + credentials);
#   docker-compose.yml mounts that directory into the containers read-only,
#   so define profiles on the host, not inside the container.
AWS_REGION=us-east-1
# The three variables below are read ONLY by the standalone cmd/aws-sync
# binary; docker compose does not pass them into containers. Under compose,
# the sync mode is chosen per account — when adding the account in the UI or
# via BOOTSTRAP_AWS_SYNC_MODE above.
AWS_SYNC_MODE=organization
AWS_ORGANIZATION_DB_ID=
AWS_MANAGEMENT_ACCOUNT_ID=
AWS_ROLE_SESSION_NAME=iam-governance-collector
AWS_EXTERNAL_ID=
# Outbound proxy for AWS/GitHub HTTPS calls. Runtime containers bypass host
# transparent-proxy/TUN devices, so on such hosts AWS calls fail inside the
# container ("unexpected eof" / connection reset) while curl works on the
# host. Point this at a proxy listening on a non-loopback address, e.g.
#   HTTPS_PROXY=http://172.17.0.1:7890   (docker0 gateway -> host proxy)
# NO_PROXY (default: localhost,127.0.0.1,postgres,redis) stays direct.
# HTTPS_PROXY=
# NO_PROXY=

# Optional PMapper worker configuration (Python CLI installed separately).
PMAPPER_BINARY=pmapper
PMAPPER_IMPORT_ARGS=import --input {input}
PMAPPER_EXPORT_ARGS=graph export --output {output}
PMAPPER_TIMEOUT=5m
PMAPPER_TEMP_DIR=
WORKER_CONCURRENCY=2
