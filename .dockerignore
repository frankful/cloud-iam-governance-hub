# Keep secrets and local build artifacts out of the image build context.
.env
*.log
*.err

# VCS / tooling state
.git
.workbuddy
.run

# Local binaries
*.exe

# Ephemeral local test fixtures
.e2e-*

# Frontend: built inside the image (Dockerfile.api); local dist + node_modules
# must not leak into the Go build stage.
frontend/node_modules
frontend/dist
